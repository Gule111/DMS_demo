# ============================================
# DMS 环境变量模板 (复制为 .env 后填入真实值)
# ============================================

# MySQL 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dms
DB_USERNAME=root
DB_PASSWORD=你的数据库密码

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET=你的JWT密钥(Base64编码,至少32字节)
